# ==============================================================================
# Hybrid AI Hallucination Checker - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL / SQLite fallback for development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hallucination_checker
# Development SQLite fallback: sqlite+aiosqlite:///./hallucination_checker.db

# API Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_in_production
API_KEY_HEADER=X-API-Key

# External Provider API Keys (backend-only, NEVER expose to frontend/extension)
LLM_PROVIDER=openai # openai, anthropic, or custom
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

SEARCH_PROVIDER=tavily # tavily, serper, duckduckgo, bing
SEARCH_API_KEY=

EMBEDDING_PROVIDER=sentence_transformers # sentence_transformers, openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# NLI Model Configuration
NLI_MODEL=roberta-large-mnli # or cross-encoder/nli-deberta-v3-base

# Hybrid Scoring Weights (Must sum to 1.0)
WEIGHT_EVIDENCE=0.35
WEIGHT_NLI=0.30
WEIGHT_SOURCE=0.20
WEIGHT_RULE=0.15

# Verification Decision Thresholds (0.0 to 1.0)
THRESHOLD_VERIFIED=0.80
THRESHOLD_PARTIAL=0.60
# Below THRESHOLD_PARTIAL is categorized as LIKELY_HALLUCINATED (if evidence exists)
# If no credible evidence is retrieved, status is categorized as INSUFFICIENT_EVIDENCE

# Source Reliability Multipliers
RELIABILITY_GOVERNMENT=1.00
RELIABILITY_ACADEMIC=0.95
RELIABILITY_UNIVERSITY=0.90
RELIABILITY_MAJOR_ORG=0.90
RELIABILITY_ENCYCLOPEDIA=0.80
RELIABILITY_MAJOR_NEWS=0.80
RELIABILITY_GENERAL=0.55
RELIABILITY_UNKNOWN=0.30

# Performance & Rate Limiting
MAX_CLAIMS_PER_REQUEST=20
SEARCH_RESULTS_PER_CLAIM=5
SEARCH_CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=30
